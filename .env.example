# Discord Bot Credentials (Required)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Optional: Dedicated Guild ID for instant slash command sync in development
# DISCORD_GUILD_ID=123456789012345678

# Reservoir API Key (Optional but recommended for higher rate limits)
# Get a free key at https://reservoir.tools
RESERVOIR_API_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
